            "shootEffect": {
                "type": "ParticleEffect",
                "particles": 12,
                "length": 20,
                "sizeFrom": 4,
                "sizeTo": 0,
                "colorFrom": "66D9FF",
                "colorTo": "FFFFFF",
                "lifetime": 20
            },
            "hitEffect": "hitBulletBig"
        }
