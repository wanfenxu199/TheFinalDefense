    // ===== 建造消耗（后期造价） =====
    "requirements": [
        { "item": "copper", "amount": 300 },
        { "item": "lead", "amount": 200 },
        { "item": "silicon", "amount": 150 },
        { "item": "plastanium", "amount": 100 },
        { "item": "surge-alloy", "amount": 80 },
        { "item": "phase-fabric", "amount": 40 }
    ],

    // ===== 电力消耗 =====
    "consumes": {
        "power": 8.0
