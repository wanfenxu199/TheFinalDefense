            "status": "electrified",
            "statusDuration": 120,
            "ammoMultiplier": 2,         // 每份弹药打2发
            "buildingDamageMultiplier": 0.6,
            "hitShake": 4,
            "hitSound": "explosion",

            // ===== 命中后分裂出闪电链 =====
            "fragBullets": 3,
            "fragBullet": {
                "type": "LightningBulletType",
                "damage": 150,
                "lightningDamage": 150,
                "lightningLength": 6,     // 连锁6个敌人
                "lightningLengthRand": 4,
                "lightningColor": "66D9FF",
                "buildingDamageMultiplier": 0.4,
                "status": "electrified",
                "statusDuration": 60
            },

            // ===== 弹头拖尾特效（简单版） =====
            

